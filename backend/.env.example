# ============================================================
# GRAVITEA-ERP Environment Variables
# ============================================================
# Copy to .env and fill in values:  cp .env.example .env
# Variables marked [REQUIRED] must be set for the app to start.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================

# --- Django Core ---

# [REQUIRED] Django settings module
DJANGO_SETTINGS_MODULE=gravitea.settings.development

# [REQUIRED] Secret key for signing (50+ chars)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-50+-character-secret-key-change-in-production

# [OPTIONAL] Debug mode (default: False in base, True in development)
DEBUG=True

# [OPTIONAL] Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---

# [REQUIRED] Full connection URL (takes precedence over individual PG vars)
DATABASE_URL=postgresql://gravitea:gravitea@localhost:5432/gravitea_dev

# [OPTIONAL] Individual PostgreSQL vars (used if DATABASE_URL not set)
# POSTGRES_DB=gravitea_dev
# POSTGRES_USER=gravitea
# POSTGRES_PASSWORD=gravitea
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Redis ---

# [REQUIRED] Redis URL for caching and JWT refresh token storage
REDIS_URL=redis://localhost:6379/0

# --- Encryption (PII Protection) ---

# [REQUIRED] AES-256-GCM key for encrypted fields (base64-encoded 32 bytes)
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# [REQUIRED] HMAC-SHA256 key for blind index searches (base64-encoded 32 bytes)
# Generate: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
HMAC_KEY=your-base64-encoded-32-byte-hmac-key

# --- JWT Authentication ---

# [OPTIONAL] RS256 keys (omit for dev — falls back to HS256 with SECRET_KEY)
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# [OPTIONAL] Token lifetimes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# [OPTIONAL] Issuer and audience claims
# JWT_ISSUER=https://auth.gravitea.io
# JWT_AUDIENCE=gravitea-api

# --- CORS ---

# [OPTIONAL] Comma-separated allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# --- OpenTelemetry (Tracing) ---

# [OPTIONAL] Enable OTEL tracing (default: false)
OTEL_TRACING_ENABLED=true

# [OPTIONAL] OTEL exporter endpoint (Jaeger OTLP gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# [OPTIONAL] Service name for traces
OTEL_SERVICE_NAME=gravitea-backend

# [OPTIONAL] Sampling ratio (0.0-1.0, default: 0.1)
# OTEL_SAMPLING_RATIO=0.1

# --- Logging ---

# [OPTIONAL] Log format: "text" (human-readable) or "json" (structured)
LOG_FORMAT=json

# [OPTIONAL] Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# --- Observability Metrics ---

# [OPTIONAL] Enable Prometheus metrics (default: true)
# METRICS_ENABLED=true

# --- Alerting ---

# [OPTIONAL] Webhook URL for alert notifications
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- SLO Thresholds ---

# [OPTIONAL] Error rate threshold (default: 0.01 = 1%)
# SLO_ERROR_RATE_THRESHOLD=0.01

# [OPTIONAL] Latency p99 threshold in ms (default: 500)
# SLO_LATENCY_P99_MS=500

# [OPTIONAL] Sync lag threshold in seconds (default: 60)
# SLO_SYNC_LAG_SECONDS=60

# --- Celery (Background Tasks) ---

# [OPTIONAL] Celery broker URL (default: redis://localhost:6379/1)
# CELERY_BROKER_URL=redis://localhost:6379/1

# [OPTIONAL] Celery result backend (default: redis://localhost:6379/2)
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Bootstrap ---

# [OPTIONAL] Run seed data during bootstrap (default: false)
# SEED_DATA=false

# --- Google Cloud (Production only) ---

# GCP_PROJECT_ID=gravitea-erp
# CLOUD_SQL_CONNECTION_NAME=project:region:instance
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# DB_CONN_MAX_AGE=0
# DB_STATEMENT_TIMEOUT=30000
